#!/usr/bin/env bash
# VPS helper:  ./bot logs | status | restart | stop | start | check | backtest | update
cd "$(dirname "$0")"
PY="$(cat .python 2>/dev/null || command -v python3)"
SERVICE=crypto-signals
case "${1:-}" in
  start|stop|restart) sudo systemctl "$1" $SERVICE && echo "$1: ok" ;;
  status)   systemctl --no-pager status $SERVICE | head -12; echo; "$PY" signals.py status ;;
  logs)     journalctl -u $SERVICE -f -n 60 --output=cat ;;
  check)    "$PY" signals.py check ;;
  backtest) "$PY" signals.py backtest ;;
  once)     "$PY" signals.py once ;;
  update)   # git checkout: pull the latest commit. Zip install: unzip a new crypto-signals.zip
            # uploaded next to this folder. Either way .env, logs/ and phone settings are kept.
            if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
              git pull --ff-only || { echo "git pull failed (local edits on the VPS? see: git status)"; exit 1; }
            else
              unzip -o ../crypto-signals.zip -x 'crypto-signals/.env' 'crypto-signals/logs/*' -d .. || exit 1
            fi
            chmod +x bot deploy/install.sh
            if [ -x .venv/bin/python ]; then .venv/bin/python -m pip install -q -r requirements.txt || true; fi
            "$PY" -m unittest discover -s tests -q && sudo systemctl restart $SERVICE && echo "updated + restarted" ;;
  *) echo "usage: ./bot logs | status | restart | stop | start | check | backtest | once | update" ;;
esac
